--- a/shop/models/order.py
+++ b/shop/models/order.py
@@ -44,8 +44,13 @@ class Order:
 
 
 def merge_lines(lines):
-    """Return one line per product, in the order the products first appear."""
+    """Return one line per product, in the order the products first appear.
+
+    The lines of one product add their quantities; the first line gives the unit price.
+    """
     merged = {}
     for line in lines:
-        merged[line.sku] = line
+        previous = merged.get(line.sku)
+        merged[line.sku] = line if previous is None else Line(line.sku, previous.qty + line.qty,
+                                                              previous.unit_cents)
     return list(merged.values())
