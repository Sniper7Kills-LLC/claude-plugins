+def csv_lines(items):
+    """Return the CSV header and one row per item, with the price in dollars."""
+    rows = ["sku,name,qty,price"]
+    for item in items:
+        rows.append(f"{item.sku},{item.name},{item.qty},{item.price // 100}.{item.price % 100:02d}")
+    return rows
+
