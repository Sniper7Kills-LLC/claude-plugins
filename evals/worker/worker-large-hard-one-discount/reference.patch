+from shop.services import DiscountAlreadyApplied, InvalidInput, NotFound
 from shop.util.text import normalize_code
 
 
@@ -19,8 +19,11 @@ class Discounts:
         return discount
 
     def apply(self, order, code):
-        """Add a code to the order. A code that the order already has changes nothing."""
+        """Add a code to the order. An order takes one code; the same code again changes nothing."""
         discount = self.find(code)
-        if discount.code not in order.discounts:
-            order.discounts.append(discount.code)
+        if discount.code in order.discounts:
+            return order
