diff --git a/shop/services/pricing.py b/shop/services/pricing.py
index 2fe4b43..ff5fe84 100644
--- a/shop/services/pricing.py
+++ b/shop/services/pricing.py
@@ -8,7 +8,7 @@ def subtotal(order):
 
 
 def discount(order, discounts):
-    """Return the discount in cents. Each code takes its percent of the subtotal."""
+    """Return the discount in cents: the percent of the order's code, of the subtotal."""
     base = subtotal(order)
     return sum(percent_of(base, discounts[code].percent) for code in order.discounts if code in discounts)
 
