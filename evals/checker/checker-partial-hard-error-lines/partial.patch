@@ -15,6 +15,15 @@ class Item(NamedTuple):
     price: int  # In cents, so that sums stay exact.
 
 
+class StockFileError(ValueError):
+    """A malformed line in a stock file, with the file path and the line number."""
+
+    def __init__(self, path, line, message):
+        super().__init__(f"{path}:{line}: {message}")
+        self.path = path
+        self.line = line
+
+
 def parse_price(text):
     """Return the price in cents for a dollar amount such as ``12.50``."""
     dollars, _, cents = text.strip().partition(".")
@@ -34,8 +43,11 @@ def load(path):
     """Return the Items of a stock file, in file order."""
     items = []
     with open(path) as handle:
-        for line in handle:
+        for number, line in enumerate(handle, start=1):
             if not line.strip() or line.lstrip().startswith("#"):
                 continue
-            items.append(parse_line(line))
+            try:
+                items.append(parse_line(line))
+            except ValueError as error:
+                raise StockFileError(path, number, error) from error
     return items
